{
  "uid": "shopper",
  "title": "Shopper \u00b7 aggregator resilience",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "tags": [
    "shopper"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Aggregator response time vs 500 ms budget",
      "description": "GET /products/{productId}. p50: half of the responses are faster (typical). p99: 1 in 100 responses is slower. p99 should stay under the budget line whatever the upstreams do (ADR 0016).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "budget 500 ms"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"product-aggregator\",uri=\"/products/{productId}\"}[30s])))",
          "legendFormat": "p50 (typical)"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"product-aggregator\",uri=\"/products/{productId}\"}[30s])))",
          "legendFormat": "p99 (slowest 1%)"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "expr": "vector(0.5)",
          "legendFormat": "budget 500 ms"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Responses by status",
      "description": "200 even when optional upstreams fail; 503 only when Catalog is down; 404 for unknown products.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{job=\"product-aggregator\",uri=\"/products/{productId}\"}[30s]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Upstream call time \u00b7 p99 (slowest 1%)",
      "description": "Each upstream is reached through its Toxiproxy alias; the timeouts are its p99.9 (Catalog 235, Customer 280, Pricing 375, Availability 470 ms).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le, client_name) (rate(http_client_requests_seconds_bucket{job=\"product-aggregator\"}[30s])))",
          "legendFormat": "{{client_name}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Degraded sections per second",
      "description": "A section is degraded when its upstream failed, timed out, was cut by the budget or its circuit is open.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (section) (rate(aggregator_sections_degraded_total[30s]))",
          "legendFormat": "{{section}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Upstream failures per second",
      "description": "Failed calls counted by each circuit breaker, and calls not even attempted because the circuit is open.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (name) (rate(resilience4j_circuitbreaker_calls_seconds_count{job=\"product-aggregator\",kind=\"failed\"}[30s]))",
          "legendFormat": "{{name}} failed"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "sum by (name) (rate(resilience4j_circuitbreaker_not_permitted_calls_total{job=\"product-aggregator\"}[30s]))",
          "legendFormat": "{{name}} rejected (circuit open)"
        }
      ]
    },
    {
      "id": 6,
      "type": "state-timeline",
      "title": "Circuit breakers",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Opens at 50% failures over the last 20 calls, stays open 10 s, then half-open (ADR 0016).",
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "closed",
                  "color": "green"
                },
                "1": {
                  "text": "half-open",
                  "color": "yellow"
                },
                "2": {
                  "text": "open",
                  "color": "red"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "legendFormat": "{{name}}",
          "expr": "2 * max by (name) (resilience4j_circuitbreaker_state{job=\"product-aggregator\",state=\"open\"}) + max by (name) (resilience4j_circuitbreaker_state{job=\"product-aggregator\",state=\"half_open\"})"
        }
      ]
    },
    {
      "id": 7,
      "type": "logs",
      "title": "Aggregator warnings",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "WARN lines from the aggregator: every failed upstream call and every 503.",
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 10
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "{service=\"product-aggregator\"} | json | log_level=\"WARN\" | line_format \"{{.message}}  traceId={{.traceId}}\""
        }
      ]
    }
  ],
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m"
    ]
  }
}